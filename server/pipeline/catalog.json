{
  "version": "2026-10",
  "about": "Curated, vendor-neutral catalogue of existing tools for finance back-office work. We have no commercial relationship with any vendor listed: no referral fees, no reseller margins. Prices are indicative monthly list prices in AED for a ~5-person finance team, collected in Oct 2026; check with the vendor before deciding. automation_rate is the share of the matching manual time a typical setup removes (an estimate, confirmed by re-measuring after go-live).",
  "needs": {
    "invoice_capture": "Reading invoice details (numbers, dates, amounts, PO) and typing or pasting them into the accounting system",
    "duplicate_check": "Fixing mistakes after the fact: rejected submits, corrections, duplicates and missed checks",
    "po_matching": "Looking up purchase orders and checking invoices against them",
    "approval_workflow": "Asking managers for approvals or approval codes, usually by email, and waiting",
    "email_followup": "Writing and answering routine emails (supplier queries, reminders, chasers)",
    "spreadsheet_tracking": "Updating tracking spreadsheets by hand",
    "cross_app_transfer": "Switching between apps and moving the same data from one to another",
    "review_checking": "A manager checking each item before it goes out (time per item is an assumption until confirmed)"
  },
